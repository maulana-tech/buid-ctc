# Creditcoin testnet RPC the dashboard reads from
NEXT_PUBLIC_CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
NEXT_PUBLIC_CREDITCOIN_EXPLORER=https://creditcoin-testnet.blockscout.com

# Fill these in after `forge script script/Deploy.s.sol`.
# While they are empty the dashboard renders a clearly-labelled demo profile.
NEXT_PUBLIC_CREDIT_REGISTRY_ADDRESS=
NEXT_PUBLIC_LENDING_HISTORY_ASC_ADDRESS=
NEXT_PUBLIC_SHARE_MARKET_ADDRESS=
NEXT_PUBLIC_DEPLOY_BLOCK=
NEXT_PUBLIC_CREDIT_LINE_ADDRESS=

# Server-only, used by /api/proof. Defaults shown; override if a public RPC starts refusing receipts.
SOURCE_CHAIN_RPC_URL=https://ethereum-rpc.publicnode.com
PROOF_BUILDER_URL=https://proof-gen-api.cc3-testnet.creditcoin.network/
