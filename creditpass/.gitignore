node_modules/

# Foundry build artefacts and vendored libraries — anchored to the repo root on purpose.
# Unanchored, `lib/` also matches web/src/lib/ and silently drops the dashboard's data layer.
/out/
/cache/
/lib/

# Secrets, at any depth.
.env
.env.local

# Honk verifier build (zk Foundry profile) and circuit scratch outputs. The compiled circuit and
# its verification key are committed so tests run without nargo/bb installed.
/out-zk/
circuits/*/target/*.gz
circuits/*/target/zkfixture/
circuits/*/Prover.toml
